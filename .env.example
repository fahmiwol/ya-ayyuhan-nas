# Salin ke .env lalu isi. JANGAN commit .env.
# Postgres (internal, tak terekspos ke host)
POSTGRES_DB=yan
POSTGRES_USER=yan
POSTGRES_PASSWORD=ganti-password-kuat-di-sini

# Rahasia sesi (WAJIB kuat & unik). Buat: openssl rand -hex 32
AUTH_SECRET=ganti-dengan-hex-32-byte-acak

# Port host untuk web (bind ke 127.0.0.1). Ganti bila 3100 sudah dipakai app lain.
WEB_PORT=3100
