āu","tr":"the sky"},{"p":4,"ar":"كَٱلْمُهْلِ","tl":"kal-muh'li","tr":"like molten copper"}],"ann":0},{"global":5384,"ayah":9,"arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","skeleton":"وتكون ٱلجبال كٱلعهن","juz":29,"page":568,"sajdah":false,"hash":"0d9e150bd22d07b4f8a43a10ef49997eec5e2cd0cdb95cf7500457c05f6c64f5","word_root":"a8891f59138b7c64ad8e12ac34d47eeb1a72c323e7310b9bd8db233f8fa9d991","sources":["quran_com","tanzil","kemenag"],"tr":{"id":"dan gunung-gunung menjadi seperti bulu (yang berterbangan),","en":"And the mountains will be like wool,"},"words":[{"p":1,"ar":"وَتَكُونُ","tl":"watakūnu","tr":"And will be"},{"p":2,"ar":"ٱلْجِبَالُ","tl":"l-jibālu","tr":"the mountains"},{"p":3,"ar":"كَٱلْعِهْنِ","tl":"kal-ʿih'ni","tr":"like wool"}],"ann":0},{"global":5385,"ayah":10,"arabic":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","skeleton":"ولا يسل حميم حميما","juz":29,"page":568,"sajdah":false,"hash":"034c3c4b99b0b0d898ab7d397558e62cbbc95744a9312686f049d54d1173e92b","word_root":"f922421f7ac87c0c661ba9c4d79e97ba4313e4cc29c65a4b0560d39e1bab1ecf","sources":["quran_com","tanzil","kemenag"],"tr":{"id":"dan tidak ada seorang teman akrabpun menanyakan temannya,","en":"And no friend will ask [anything of] a friend,"},"words":[{"p":1,"ar":"وَلَا","tl":"walā","tr":"And not"},{"p":2,"ar":"يَسْـَٔلُ","tl":"yasalu","tr":"will ask"},{"p":3,"ar":"حَمِيمٌ","tl":"ḥamīmun","tr":"a friend"},{"p":4,"ar":"حَمِيمًۭا","tl":"ḥamīman","tr":"(about) a friend"}],"ann":0},{"global":5386,"ayah":11,"arabic":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","skeleton":"يبصرونهم يود ٱلمجرم لو يفتدى من عذاب يومئذ ببنيه","juz":29,"page":569,"sajdah":false,"hash":"233cb64c13eec4d08f0b5c04d9167bae741846863403679b53f9fa8893268231","word_root":"de8f210dbc2954271c5c26d2ca5ec153807d193a480f84509a731899f8b044da","sources":["quran_com","tanzil","kemenag"],"tr":{"id":"sedang mereka saling memandang. Orang kafir ingin kalau sekiranya dia dapat menebus (dirinya) dari azab hari itu deng