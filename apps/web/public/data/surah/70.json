 idol, hastening."},"words":[{"p":1,"ar":"يَوْمَ","tl":"yawma","tr":"(The) Day"},{"p":2,"ar":"يَخْرُجُونَ","tl":"yakhrujūna","tr":"they will come out"},{"p":3,"ar":"مِنَ","tl":"mina","tr":"from"},{"p":4,"ar":"ٱلْأَجْدَاثِ","tl":"l-ajdāthi","tr":"the graves"},{"p":5,"ar":"سِرَاعًۭا","tl":"sirāʿan","tr":"rapidly"},{"p":6,"ar":"كَأَنَّهُمْ","tl":"ka-annahum","tr":"as if they (were)"},{"p":7,"ar":"إِلَىٰ","tl":"ilā","tr":"to"},{"p":8,"ar":"نُصُبٍۢ","tl":"nuṣubin","tr":"a goal"},{"p":9,"ar":"يُوفِضُونَ","tl":"yūfiḍūna","tr":"hastening"}],"ann":0},{"global":5419,"ayah":44,"arabic":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","skeleton":"خشعة أبصرهم ترهقهم ذلة ذلك ٱليوم ٱلذى كانوا يوعدون","juz":29,"page":570,"sajdah":false,"hash":"044c7e8f684b409c50b3e7635527a7b95a1297809689fc7651421e2967c4d652","word_root":"8b3175df12c9442b1f4643029ea25e4f984811b6e2becea32f89ee4411e398ba","sources":["quran_com","tanzil","kemenag"],"tr":{"id":"dalam keadaan mereka menekurkan pandangannya (serta) diliputi kehinaan. Itulah hari yang dahulunya diancamkan kepada mereka.","en":"Their eyes humbled, humiliation will cover them. That is the Day which they had been promised."},"words":[{"p":1,"ar":"خَـٰشِعَةً","tl":"khāshiʿatan","tr":"Humbled"},{"p":2,"ar":"أَبْصَـٰرُهُمْ","tl":"abṣāruhum","tr":"their eyesights"},{"p":3,"ar":"تَرْهَقُهُمْ","tl":"tarhaquhum","tr":"will cover them"},{"p":4,"ar":"ذِلَّةٌۭ ۚ","tl":"dhillatun","tr":"humiliation"},{"p":5,"ar":"ذَٰلِكَ","tl":"dhālika","tr":"That"},{"p":6,"ar":"ٱلْيَوْمُ","tl":"l-yawmu","tr":"(is) the Day"},{"p":7,"ar":"ٱلَّذِى","tl":"alladhī","tr":"which"},{"p":8,"ar":"كَانُوا۟","tl":"kānū","tr":"they were"},{"p":9,"ar":"يُوعَدُونَ","tl":"yūʿadūna","tr":"promised"}],"ann":0}]}