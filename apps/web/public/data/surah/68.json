e"},{"p":10,"ar":"وَيَقُولُونَ","tl":"wayaqūlūna","tr":"and they say"},{"p":11,"ar":"إِنَّهُۥ","tl":"innahu","tr":"Indeed, he"},{"p":12,"ar":"لَمَجْنُونٌۭ","tl":"lamajnūnun","tr":"(is) surely mad"}],"ann":0},{"global":5323,"ayah":52,"arabic":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","skeleton":"وما هو إلا ذكر للعلمين","juz":29,"page":566,"sajdah":false,"hash":"4d7e7ecbee055045ff8a46fd1ed7b1fb66a4f5fbae1072c63e1aae4930d32e83","word_root":"cb98e0c0737fbea531ba8ac98c8f525b1320d9ff3dc5fcafb6bc0524e3cbd51f","sources":["quran_com","tanzil","kemenag"],"tr":{"id":"Dan Al Quran itu tidak lain hanyalah peringatan bagi seluruh umat.","en":"But it is not except a reminder to the worlds."},"words":[{"p":1,"ar":"وَمَا","tl":"wamā","tr":"And not"},{"p":2,"ar":"هُوَ","tl":"huwa","tr":"it (is)"},{"p":3,"ar":"إِلَّا","tl":"illā","tr":"but"},{"p":4,"ar":"ذِكْرٌۭ","tl":"dhik'run","tr":"a Reminder"},{"p":5,"ar":"لِّلْعَـٰلَمِينَ","tl":"lil'ʿālamīna","tr":"to the worlds"}],"ann":0}]}